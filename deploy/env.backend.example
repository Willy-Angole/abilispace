# Copy this to /var/www/shiriki/serve/.env on the Droplet
# Fill in ALL values before starting the app

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ✅ PASTE YOUR RENDER EXTERNAL DATABASE URL HERE
DATABASE_URL=postgres://user:password@dpg-xxxxx.oregon-postgres.render.com:5432/dbname

# Leave these blank if not using Hasura
HASURA_GRAPHQL_ENDPOINT=
HASURA_GRAPHQL_ADMIN_SECRET=
HASURA_GRAPHQL_JWT_SECRET=

# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional — leave blank to disable caching)
REDIS_URL=

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ✅ Set this to your Droplet IP or domain
CORS_ORIGIN=http://YOUR_DOMAIN_OR_IP

LOG_LEVEL=info
PASSWORD_RESET_CODE_EXPIRY_MINUTES=15
